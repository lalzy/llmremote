@page
<meta name="viewport" content="width=device-width, initial-scale=1" />

<link rel="stylesheet" href="~/css/site.css" />

<body>
    <div class="main">
	<!-- Llama -->
	<div class="service-row">
	    <p id="llamastatus" class="server-status offline">Llama: Checking...</p>
	    <p id="comfystatus" class="server-status offline">ComfyUI: Checking...</p>
	    <button id="comfyButton" type="button">Start</button>
	</div>

	<!-- Nvidia HW usage -->
	<div id="hwUsage">
	    <div id="gpus"></div>
	</div>
	
	<!-- Timer -->
	<div class="timer">
	    <div class="timer-row" hidden>
		<p id="timerLeft"></p>
		<button id="timerCancel" tpye="button">Cancel</button>
	    </div>
	    <p id="timerError" class="error"></p>
	    <div class="timer-row">
		<select id="timerUnit">
		    <option value="Minutes">Minutes</option>
		    <option value="Hours">Hours</option>
		</select>
		<input id="timerValue" type="number" min"1">
		<button id="timerSet" type="button">Set</button>
	    </div>
	    <button id="addModel" class="button-main">Add Model</button>
	    <select id="sortSelect">
		<option value="Name">Name</option>
		<option value="ID">ID</option>
		<option value="Created">Created</option>
		<option value="Updated">Updated</option>
	    </select>
	</div>
	
	<!-- Models -->
	<ul id="modelList"></ul>
	<p id="emptyText"hidden>No models Yet</p>
    </div>

    <!-- Add/Edit modal -->
    <dialog id="modalDialog">
	<form id="modelForm">
	    <h2 id="modelDialogTitle">Add Model</h2>
	    <label>
		Name
		<input id="nameInput" required>
	    </label>
	    <label>
		File Path
		<input id="filePathInput" required>
	    </label>
	    <label>
		Context Size
		<input id="contextInput" type="number" min="1" placeholder="model default">
	    </label>

	    <p id="formError" class="error"></p>
	    
	    <div class="actions">
		<button type="button" class="cancel-button">Cancel</button>
		<button type="submit" class="main-Button">Save</button>
	    </div>
	</form>
    </dialog>

    <!-- Confirm Delete modal -->
    <dialog id="deleteDialog">
	<h2>Delete model</h2>
	<p>Are you sure you want to delete <strong id="deleteName"></strong>?</p>
	<div class="actions">
	    <button type="button" class="cancel-button">Cancel</button>
	    <button type="button" id="confirm-button" class="danger-button">Confirm</button>
	</div>
    </dialog>
</body>
<script src="~/js/site.js" asp-append-version="true"></script>
